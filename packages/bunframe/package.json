{
  "name": "@z2net/bunframe",
  "version": "0.1.0",
  "description": "The desktop application shell for Bun: native wry windows, typed schema-first RPC and the CLI - one package, platform binaries resolved automatically.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z2net/bunframe.git",
    "directory": "packages/bunframe"
  },
  "bugs": {
    "url": "https://github.com/z2net/bunframe/issues",
    "email": "contact@z2net.com"
  },
  "author": {
    "name": "z2net",
    "email": "contact@z2net.com"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "bunframe": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./view": "./src/view.ts",
    "./cli": "./src/cli/index.ts"
  },
  "imports": {
    "#schema": "./src/schema/index.ts",
    "#schema/*": "./src/schema/*",
    "#core": "./src/core/index.ts",
    "#core/*": "./src/core/*",
    "#app/*": "./src/app/*",
    "#view": "./src/view.ts",
    "#cli": "./src/cli/index.ts",
    "#cli/*": "./src/cli/*",
    "#template/*": "./src/cli/template/*"
  },
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@z2net/bffi": "^0.2.1"
  }
}
